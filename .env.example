PORT=3000
# Admin account (created on first start if no admin exists). If ADMIN_PASSWORD is empty a random one is printed once.
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=
# Merchant numbers shown to buyers at checkout
BKASH_NUMBER=
NAGAD_NUMBER=
ROCKET_NUMBER=
SUPPORT_WHATSAPP=
SUPPORT_HOURS=9AM–1AM
# Player-name lookup (any JSON GET API). {uid} and {region} are substituted. Leave empty to disable.
UID_API_URL=
UID_API_KEY=
UID_API_NAME_FIELD=nickname
# WhatsApp/SMS: any gateway that accepts a JSON POST {to, message}. Leave empty to only log to the outbox table.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
# Optional overrides
# DB_FILE=./data/shop.db
